// Watch Tracker Phase 1 lean logical model
// Generated; authoritative definitions are in scripts/generate_phase1_data_model.py

Table canon_pack {
  canon_pack_id uuid [pk, not null]
  slug varchar(128) [not null, unique]
  title text [not null]
  created_at timestamp [not null]
  Note: 'MVP-required: Identifies the logical Canon Pack across releases.'
}

Table canon_pack_release {
  canon_pack_release_id uuid [pk, not null]
  canon_pack_id uuid [not null]
  version varchar(64) [not null]
  contract_version varchar(32) [not null]
  core_schema_range varchar(128) [not null]
  artifact_sha256 varchar(64) [not null, unique]
  release_metadata json [not null]
  published_at timestamp [not null]
  Indexes { (canon_pack_id, version) [unique, name: 'uq_canon_pack_release_1'] }
  Note: 'MVP-required: Stores immutable release metadata and verified artifact details.'
}

Table canon_entity {
  canon_entity_id uuid [pk, not null]
  canon_pack_id uuid [not null]
  canonical_urn varchar(512) [not null, unique]
  entity_class varchar(32) [not null]
  Note: 'MVP-required: Provides stable canonical identity across all releases and types.'
}

Table canon_entity_revision {
  canon_entity_revision_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  canon_entity_id uuid [not null]
  slug varchar(160) [not null]
  title text [not null]
  aliases json
  summary text
  extension_document json
  Indexes { (canon_pack_release_id, canon_entity_id) [unique, name: 'uq_canon_entity_revision_1'] }
  Indexes { (canon_pack_release_id, slug) [unique, name: 'uq_canon_entity_revision_2'] }
  Note: 'MVP-required: Stores release-scoped common entity labels and metadata.'
}

Table canon_entity_identity_link {
  canon_entity_identity_link_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  subject_canon_entity_id uuid [not null]
  target_canon_entity_id uuid [not null]
  link_kind varchar(32) [not null]
  provenance_claim_id uuid
  Note: 'Optional: Records governed equivalence or replacement links between identities.'
}

Table canon_term_revision {
  canon_term_revision_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  canon_entity_id uuid [not null]
  term_kind varchar(48) [not null]
  code varchar(128) [not null]
  label text [not null]
  display_weight int
  capabilities json
  presentation json
  Indexes { (canon_pack_release_id, term_kind, code) [unique, name: 'uq_canon_term_revision_1'] }
  Note: 'MVP-required: Defines release-scoped declarative types, roles, and vocabularies.'
}

Table source_revision {
  source_revision_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  canon_entity_id uuid [not null]
  source_type varchar(48) [not null]
  citation text [not null]
  url varchar(2048)
  retrieved_at timestamp
  license json
  Indexes { (canon_pack_release_id, canon_entity_id) [unique, name: 'uq_source_revision_1'] }
  Note: 'MVP-required: Stores immutable release-scoped provenance-source details.'
}

Table source_relation {
  source_relation_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  subject_source_revision_id uuid [not null]
  target_source_revision_id uuid [not null]
  relation_kind varchar(48) [not null]
  note text
  Note: 'Optional: Relates sources through governed citation or derivation semantics.'
}

Table provenance_claim {
  provenance_claim_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  canon_entity_revision_id uuid
  record_kind varchar(64) [not null]
  record_id uuid [not null]
  field_path varchar(512)
  method varchar(32) [not null]
  note text
  Note: 'MVP-required: Identifies a record- or field-level canonical claim.'
}

Table provenance_claim_source {
  provenance_claim_source_id uuid [pk, not null]
  provenance_claim_id uuid [not null]
  source_revision_id uuid [not null]
  locator text
  note text
  Indexes { (provenance_claim_id, source_revision_id) [unique, name: 'uq_provenance_claim_source_1'] }
  Note: 'MVP-required: Connects each provenance claim to supporting sources.'
}

Table decision_record {
  decision_record_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  decision_code varchar(128) [not null]
  status varchar(32) [not null]
  title text [not null]
  rationale text [not null]
  effective_at timestamp [not null]
  Indexes { (canon_pack_release_id, decision_code) [unique, name: 'uq_decision_record_1'] }
  Note: 'Optional: Captures governed canonical modeling decisions and rationale.'
}

Table container_revision {
  container_revision_id uuid [pk, not null]
  canon_entity_revision_id uuid [not null, unique]
  container_kind_canon_term_revision_id uuid [not null]
  presentation json
  Note: 'MVP-required: Stores release-scoped structural Container records.'
}

Table watchable_revision {
  watchable_revision_id uuid [pk, not null]
  canon_entity_revision_id uuid [not null, unique]
  watchable_type_canon_term_revision_id uuid [not null]
  runtime_minutes int
  spoiler_metadata json
  extension_document json
  Note: 'MVP-required: Stores release-scoped Watchable metadata and type assignment.'
}

Table first_public_release {
  first_public_release_id uuid [pk, not null]
  watchable_revision_id uuid [not null, unique]
  release_date date [not null]
  precision varchar(16) [not null]
  status varchar(24) [not null]
  region_code varchar(32)
  contributor_note text
  provenance_claim_id uuid [not null]
  Note: 'MVP-required: Stores the Phase 1 first-public-release fact per Watchable revision.'
}

Table external_identifier {
  external_identifier_id uuid [pk, not null]
  canon_entity_revision_id uuid [not null]
  namespace varchar(128) [not null]
  value varchar(512) [not null]
  provenance_claim_id uuid [not null]
  Indexes { (canon_entity_revision_id, namespace, value) [unique, name: 'uq_external_identifier_1'] }
  Note: 'Optional: Associates canonical entities with external namespace/value identifiers.'
}

Table media_reference {
  media_reference_id uuid [pk, not null]
  canon_entity_revision_id uuid [not null]
  media_kind varchar(32) [not null]
  url varchar(2048) [not null]
  title text
  language varchar(32)
  duration_seconds int
  provenance_claim_id uuid
  Note: 'MVP-required: Stores governed poster, artwork, and trailer references.'
}

Table entity_organization {
  entity_organization_id uuid [pk, not null]
  canon_entity_revision_id uuid [not null]
  organization_canon_entity_revision_id uuid [not null]
  role_canon_term_revision_id uuid [not null]
  provenance_claim_id uuid
  Note: 'Optional: Assigns reusable organizations to entities in defined roles.'
}

Table classification_value_revision {
  classification_value_revision_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  canon_entity_id uuid [not null]
