  slug varchar(128) [not null]
  label text [not null]
  Indexes { (canon_pack_release_id, dimension_canon_term_revision_id, slug) [unique, name: 'uq_classification_value_revision_1'] }
  Note: 'Optional: Defines release-scoped reusable classification values.'
}

Table classification_value_parent {
  classification_value_parent_id uuid [pk, not null]
  child_classification_value_revision_id uuid [not null]
  parent_classification_value_revision_id uuid [not null]
  position int
  Note: 'Optional: Represents classification hierarchy edges.'
}

Table entity_classification {
  entity_classification_id uuid [pk, not null]
  canon_entity_revision_id uuid [not null]
  classification_value_revision_id uuid [not null]
  provenance_claim_id uuid
  Indexes { (canon_entity_revision_id, classification_value_revision_id) [unique, name: 'uq_entity_classification_1'] }
  Note: 'Optional: Assigns classification values to canonical entities.'
}

Table container_membership_revision {
  container_membership_revision_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  container_canon_entity_revision_id uuid [not null]
  member_canon_entity_revision_id uuid [not null]
  role_canon_term_revision_id uuid [not null]
  position int
  provenance_claim_id uuid [not null]
  Note: 'MVP-required: Stores immutable release-scoped structural memberships and ordering.'
}

Table watch_relationship_revision {
  watch_relationship_revision_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  prerequisite_watchable_revision_id uuid [not null]
  watchable_revision_id uuid [not null]
  relationship_type_canon_term_revision_id uuid [not null]
  summary text
  provenance_claim_id uuid [not null]
  Note: 'MVP-required: Stores immutable directed Watchable relationships and prerequisites.'
}

Table watch_guide_revision {
  watch_guide_revision_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  canon_entity_id uuid [not null]
  slug varchar(160) [not null]
  title text [not null]
  description text
  Indexes { (canon_pack_release_id, canon_entity_id) [unique, name: 'uq_watch_guide_revision_1'] }
  Note: 'Optional: Defines immutable release-scoped Watch Guides.'
}

Table guide_stage_revision {
  guide_stage_revision_id uuid [pk, not null]
  watch_guide_revision_id uuid [not null]
  position int [not null]
  stage_mode varchar(32) [not null]
  title text
  description text
  Indexes { (watch_guide_revision_id, position) [unique, name: 'uq_guide_stage_revision_1'] }
  Note: 'Optional: Defines ordered stages within a Watch Guide revision.'
}

Table guide_entry_revision {
  guide_entry_revision_id uuid [pk, not null]
  guide_stage_revision_id uuid [not null]
  canon_entity_revision_id uuid [not null]
  position int [not null]
  inclusion_class varchar(24) [not null]
  choice_group varchar(64)
  Indexes { (guide_stage_revision_id, position) [unique, name: 'uq_guide_entry_revision_1'] }
  Note: 'Optional: Places canonical entities within Guide stages.'
}

Table extension_schema_version {
  extension_schema_version_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  namespace varchar(255) [not null]
  version varchar(64) [not null]
  schema_uri varchar(2048) [not null]
  schema_sha256 varchar(64) [not null]
  Indexes { (canon_pack_release_id, namespace, version) [unique, name: 'uq_extension_schema_version_1'] }
  Note: 'Optional: Governs namespaced Canon extension-document schemas.'
}

Table tracker_instance {
  tracker_instance_id uuid [pk, not null]
  display_name text [not null]
  credential_hash text
  setup_completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  Note: 'MVP-required: Stores deployment-wide setup and authentication state.'
}

Table viewing_attempt {
  viewing_attempt_id uuid [pk, not null]
  tracker_instance_id uuid [not null]
  canon_entity_id uuid [not null]
  watch_focus_id uuid
  is_rewatch boolean [not null]
  idempotency_key varchar(128) [not null, unique]
  started_at timestamp [not null]
  Indexes { (tracker_instance_id, canon_entity_id) [unique, name: 'uq_viewing_attempt_1'] }
  Note: 'MVP-required: Stores the single active incomplete attempt for a Watchable.'
}

Table viewing_session {
  viewing_session_id uuid [pk, not null]
  tracker_instance_id uuid [not null]
  canon_entity_id uuid [not null]
  watch_focus_id uuid
  started_at timestamp
  completed_at timestamp [not null]
  rewatch_sequence int [not null]
  completion_provenance varchar(32) [not null]
  idempotency_key varchar(128) [not null, unique]
  Note: 'MVP-required: Retains one immutable completed viewing event for a Watchable.'
}

Table watchable_feedback {
  watchable_feedback_id uuid [pk, not null]
  tracker_instance_id uuid [not null]
  canon_entity_id uuid [not null]
  viewing_session_id uuid
  feedback_scope varchar(16) [not null]
  rating decimal
  favorite boolean [not null]
  would_rewatch boolean [not null]
  note text
  review text
  note_has_spoilers boolean [not null]
  review_has_spoilers boolean [not null]
  updated_at timestamp [not null]
  Note: 'MVP-required: Stores overall and optional per-session feedback without altering viewing history.'
}

Table tracker_preference {
  tracker_preference_id uuid [pk, not null]
  tracker_instance_id uuid [not null]
  preference_key varchar(128) [not null]
  preference_value json [not null]
  updated_at timestamp [not null]
  Indexes { (tracker_instance_id, preference_key) [unique, name: 'uq_tracker_preference_1'] }
  Note: 'MVP-required: Stores mutable display, ordering, and spoiler preferences.'
}

Table spoiler_reveal {
  spoiler_reveal_id uuid [pk, not null]
  tracker_instance_id uuid [not null]
  canon_entity_id uuid [not null]
  revealed_at timestamp [not null]
  Indexes { (tracker_instance_id, canon_entity_id) [unique, name: 'uq_spoiler_reveal_1'] }
  Note: 'Optional: Records explicit per-Watchable spoiler-reveal choices.'
}

Table local_override {
  local_override_id uuid [pk, not null]
  tracker_instance_id uuid [not null]
  canon_entity_id uuid [not null]
  field_path varchar(512) [not null]
  override_value json [not null]
  reason text
  updated_at timestamp [not null]
  Indexes { (tracker_instance_id, canon_entity_id, field_path) [unique, name: 'uq_local_override_1'] }
  Note: 'Optional: Stores governed user-owned overlays on immutable Canon content.'
}

Table personal_watch_relationship {
  personal_watch_relationship_id uuid [pk, not null]
  tracker_instance_id uuid [not null]
  prerequisite_canon_entity_id uuid [not null]
  watchable_canon_entity_id uuid [not null]
  note text
  created_at timestamp [not null]
  Note: 'Optional: Stores user-defined prerequisite relationships.'
}

Table watch_focus {
  watch_focus_id uuid [pk, not null]
  tracker_instance_id uuid [not null]
  target_canon_entity_id uuid
  name text [not null]
  route_strategy varchar(48) [not null]
  status varchar(24) [not null]
  is_active boolean [not null]
  configuration json [not null]
  created_at timestamp [not null]
  completed_at timestamp
  Note: 'MVP-required: Stores saved Focus identity, target, lifecycle, and active status.'
}

Table watch_focus_rule {
  watch_focus_rule_id uuid [pk, not null]
  watch_focus_id uuid [not null]
  rule_kind varchar(48) [not null]
  position int [not null]
  rule_document json [not null]
  Indexes { (watch_focus_id, rule_kind, position) [unique, name: 'uq_watch_focus_rule_1'] }
  Note: 'MVP-required: Stores validated filters, policies, weights, pins, and decisions.'
}

Table watch_focus_completion {
  watch_focus_completion_id uuid [pk, not null]
  watch_focus_id uuid [not null, unique]
  canon_pack_release_id uuid [not null]
  completed_at timestamp [not null]
  completion_snapshot json [not null]
  snapshot_sha256 varchar(64) [not null]
  Note: 'Optional: Preserves immutable completion snapshots for finished Focuses.'
}

Table focus_change_set {
  focus_change_set_id uuid [pk, not null]
  watch_focus_id uuid [not null]
  from_canon_pack_release_id uuid [not null]
  to_canon_pack_release_id uuid [not null]
  status varchar(24) [not null]
  change_document json [not null]
  created_at timestamp [not null]
  resolved_at timestamp
  Note: 'Optional: Records reconciliation outcomes after Canon graph changes.'
}

Table watch_focus_projection {
  watch_focus_projection_id uuid [pk, not null]
  watch_focus_id uuid [not null, unique]
  canon_pack_release_id uuid [not null]
  algorithm_version varchar(64) [not null]
  queue_document json [not null]
  explanation_document json [not null]
  baseline_sha256 varchar(64) [not null]
  generated_at timestamp [not null]
  Note: 'MVP-required: Caches the generated Focus queue, explanations, and reconciliation baseline.'
}

Table deployment_session {
  deployment_session_id uuid [pk, not null]
  tracker_instance_id uuid [not null]
  token_hash varchar(128) [not null, unique]
  csrf_hash varchar(128) [not null]
  created_at timestamp [not null]
  last_seen_at timestamp [not null]
  idle_expires_at timestamp [not null]
  absolute_expires_at timestamp [not null]
  revoked_at timestamp
  Note: 'Infrastructure: Stores hashed deployment authentication sessions and expiration state.'
}

Table password_reset_token {
  token_sha256 char(64) [pk, not null]
  tracker_instance_id uuid [not null]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  created_at timestamptz [not null]
  failed_attempt_count smallint [not null]
  Note: 'Infrastructure: Stores digest-only, short-lived host-admin reset tokens bound to the Tracker instance; successful or exhausted tokens are consumed.'
}

Table canon_pack_repository {
  canon_pack_repository_id uuid [pk, not null]
  tracker_instance_id uuid [not null]
  repository_url varchar(2048) [not null]
  release_channel varchar(32) [not null]
  trust_policy json [not null]
  created_at timestamp [not null]
  Note: 'Infrastructure: Configures the Phase 1 Canon Pack release source.'
}

Table canon_pack_import {
  canon_pack_import_id uuid [pk, not null]
  canon_pack_repository_id uuid
  canon_pack_release_id uuid
  artifact_sha256 varchar(64) [not null]
  status varchar(24) [not null]
  validation_report json [not null]
  started_at timestamp [not null]
  completed_at timestamp
  Note: 'Infrastructure: Records validation and transactional import attempts.'
}

Table canon_pack_activation {
  canon_pack_activation_id uuid [pk, not null]
  canon_pack_release_id uuid [not null]
  canon_pack_import_id uuid [not null]
  activated_at timestamp [not null]
  deactivated_at timestamp
  Note: 'Infrastructure: Records which verified release was active during each interval.'
}

Table canon_pack_update_check {
  canon_pack_update_check_id uuid [pk, not null]
  canon_pack_repository_id uuid [not null]
  status varchar(24) [not null]
  candidate_version varchar(64)
  result_document json [not null]
  started_at timestamp [not null]
  completed_at timestamp
  Note: 'Infrastructure: Records update checks and discovered candidate releases.'
}

Table schema_migration_run {
  schema_migration_run_id uuid [pk, not null]
  application_version varchar(64) [not null]
  database_version varchar(64) [not null]
  status varchar(24) [not null]
  backup_reference text
  error_code varchar(128)
  started_at timestamp [not null]
  completed_at timestamp
  Note: 'Infrastructure: Records guarded startup migration executions and outcomes.'
}

Table schema_migration {
  schema_migration_id varchar(128) [pk, not null]
  schema_migration_run_id uuid [not null]
  checksum_sha256 varchar(64) [not null]
  applied_at timestamp [not null]
  Note: 'Infrastructure: Tracks individual migration versions and checksums.'
}

Table portable_transfer {
  portable_transfer_id uuid [pk, not null]
  tracker_instance_id uuid [not null]
  direction varchar(16) [not null]
  format_version varchar(32) [not null]
  artifact_sha256 varchar(64)
  status varchar(24) [not null]
  result_document json [not null]
  started_at timestamp [not null]
  completed_at timestamp
  Note: 'Infrastructure: Records portable export, restore, and validation operations.'
}

