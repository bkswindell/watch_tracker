{
  "name": "watch-tracker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.3"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "tsc --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check apps packages scripts tests package.json tsconfig.json tsconfig.build.json eslint.config.js compose.yaml .github/workflows",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "build:deterministic": "node scripts/verify-deterministic-build.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "start": "node dist/apps/api/src/server.js"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.2",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.1",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2"
  },
  "license": "Apache-2.0"
}
